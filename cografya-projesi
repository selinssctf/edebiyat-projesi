<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>3D Cografya Sandbox Kesif Oyunu</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            font-family: Arial, sans-serif;
            user-select: none;
            background-color: #1a1a1a;
            color: #ffffff;
        }
        #canvas-container {
            width: 100vw;
            height: 100vh;
            display: block;
        }
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 10px;
            height: 10px;
            background-color: rgba(255, 255, 255, 0.9);
            border: 2px solid #000;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 20;
        }
        #hud {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(0, 0, 0, 0.75);
            padding: 15px;
            border-radius: 10px;
            font-size: 14px;
            z-index: 20;
            border: 1px solid #444;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        #menu-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.96);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
        }
        .btn {
            background: #2563eb;
            color: white;
            border: none;
            padding: 12px 20px;
            margin: 6px;
            font-size: 15px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            width: 280px;
        }
        .btn:hover {
            background: #1d4ed8;
            transform: scale(1.02);
        }
        #quiz-modal {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(15, 23, 42, 0.98);
            padding: 25px;
            border-radius: 12px;
            border: 2px solid #3b82f6;
            display: none;
            max-width: 480px;
            width: 90%;
            text-align: center;
            z-index: 200;
            box-shadow: 0 10px 25px rgba(0,0,0,0.8);
        }
        .opt-btn {
            background: #334155;
            color: white;
            border: 1px solid #475569;
            padding: 12px;
            margin: 6px 0;
            width: 100%;
            border-radius: 6px;
            cursor: pointer;
            text-align: left;
            font-size: 14px;
            transition: background 0.2s;
        }
        .opt-btn:hover {
            background: #475569;
        }
        #controls-info {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.7);
            padding: 12px;
            border-radius: 8px;
            font-size: 13px;
            z-index: 20;
            border: 1px solid #444;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <div id="canvas-container"></div>
    <div id="crosshair"></div>

    <div id="hud">
        <div>Blok Envanteri: <span id="block-count">20</span></div>
        <div>Aktif Bolge: <span id="current-biome">Secilmedi</span></div>
        <div>Kamera: <span id="cam-mode">FPS (V ile degis)</span></div>
        <div>Soru Cozme: [E] Tusu</div>
    </div>

    <div id="controls-info">
        Sol Tik: Blok Koy<br>
        Sag Tik: Blok Sil<br>
        W / S: Ileri / Geri<br>
        A / D: Sol / Sag<br>
        V: Kamera Degistir (FPS/TPS)<br>
        E: Soru Coz
    </div>

    <div id="quiz-modal">
        <h3 id="quiz-title" style="margin-top:0; color:#60a5fa;">Cografya Test Sorusu</h3>
        <p id="quiz-question" style="font-size:16px; line-height:1.4;">Soru metni yükleniyor...</p>
        <div id="quiz-options"></div>
    </div>

    <div id="menu-overlay">
        <h1 style="color:#60a5fa; margin-bottom:5px;">COGRAFYA SANAL KESIF OYUNU</h1>
        <p style="color:#cbd5e1; margin-bottom:20px;">Gezmek ve insa etmek istediginiz bolgeyi secin:</p>
        
        <button class="btn" onclick="startGame('karadeniz')">Karadeniz Bolgesi (Orman / Ahsap)</button>
        <button class="btn" onclick="startGame('akdeniz')">Akdeniz Bolgesi (Maki / Tas)</button>
        <button class="btn" onclick="startGame('ege')">Ege Bolgesi (Zeytinlik / Beyaz Tas)</button>
        <button class="btn" onclick="startGame('ic_anadolu')">Ic Anadolu (Bozkir / Kerpic)</button>
        <button class="btn" onclick="startGame('marmara')">Marmara Bolgesi (Karma Iklim / Tugla)</button>

        <div style="margin-top: 20px;">
            <label style="font-size:14px; color:#cbd5e1;">Karakter Rengi Secin: </label>
            <input type="color" id="char-color" value="#2563eb" style="cursor:pointer; vertical-align:middle;">
        </div>
    </div>

    <script>
        let scene, camera, renderer;
        let player, playerBody, leftLeg, rightLeg, headMesh;
        let blocks = [];
        let raycaster, mouse;
        let moveForward = false, moveBackward = false, moveLeft = false, moveRight = false;
        let prevTime = performance.now();
        let velocity = new THREE.Vector3();
        let direction = new THREE.Vector3();
        
        let isThirdPerson = false;
        let blockInventory = 20;
        let activeBiome = 'karadeniz';
        let characterColor = 0x2563eb;

        let cameraPitch = 0;
        let cameraYaw = 0;
        let isPointerLocked = false;
        let highlightBox;

        const questions = {
            karadeniz: [
                { q: "Karadeniz bolgesinin en yaygin bitki ortusu nedir?", a: ["Bozkir", "Orman", "Maki", "Savak"], c: 1 },
                { q: "Karadeniz ikliminde en cok yagis hangi mevsimde gorulur?", a: ["Sonbahar", "Ilkbahar", "Yaz", "Kis"], c: 0 },
                { q: "Karadeniz kiyilarinda ev yapiminda hangi malzeme kullanilir?", a: ["Toprak", "Kerpic", "Ahsap", "Mermer"], c: 2 },
                { q: "Dogu Karadeniz daglarinin denize bakisi nasildir?", a: ["Paralel", "Dik", "Capraz", "Kesisent"], c: 0 }
            ],
            akdeniz: [
                { q: "Akdeniz ikliminin tipik bitki ortusu nedir?", a: ["Orman", "Maki", "Taiga", "Tundra"], c: 1 },
                { q: "Akdeniz bolgesinde yaz mevsimi nasil gecer?", a: ["Soguk ve Nemli", "Sicak ve Kurak", "Yagisli", "Ilik ve Sisli"], c: 1 },
                { q: "Maki ortusunu olusturan bitkilerin yaprak yapisi nasildir?", a: ["Genis ve Yumusak", "Kucuk ve Sert", "Igne Yaprak", "Yapraksiz"], c: 1 }
            ],
            ege: [
                { q: "Ege bolgesinde daglar denize nasil uzanir?", a: ["Paralel", "Dik", "Capraz", "Düz"], c: 1 },
                { q: "Ege bolgesinde yaygin olarak yetisen tarim urunu hangisidir?", a: ["Zeytin", "Cay", "Findik", "Muz"], c: 0 }
            ],
            ic_anadolu: [
                { q: "Ic Anadolu bolgesinin dogal bitki ortusu nedir?", a: ["Maki", "Bozkir", "Orman", "Gür Cayir"], c: 1 },
                { q: "Ic Anadolu bolgesinde geleneksel yapi malzemesi nedir?", a: ["Ahsap", "Kerpic", "Bambu", "Mermer"], c: 1 }
            ],
            marmara: [
                { q: "Marmara bolgesinde kac farkli iklim tipi gorulur?", a: ["1", "2", "3", "4"], c: 2 },
                { q: "Marmara bolgesinin yersekilleri genelde nasildir?", a: ["Cok Yuksek", "Sade ve Alcak", "Sarp Daglik", "Kanyonlu"], c: 1 }
            ]
        };

        function init() {
            const container = document.getElementById('canvas-container');
            
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x7ec0ee);
            scene.fog = new THREE.FogExp2(0x7ec0ee, 0.01);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            container.appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const sunLight = new THREE.DirectionalLight(0xffffff, 0.9);
            sunLight.position.set(40, 80, 40);
            sunLight.castShadow = true;
            sunLight.shadow.mapSize.width = 2048;
            sunLight.shadow.mapSize.height = 2048;
            scene.add(sunLight);

            raycaster = new THREE.Raycaster();
            mouse = new THREE.Vector2();

            const boxGeo = new THREE.BoxGeometry(1.02, 1.02, 1.02);
            const boxMat = new THREE.MeshBasicMaterial({ color: 0x00ff00, wireframe: true });
            highlightBox = new THREE.Mesh(boxGeo, boxMat);
            highlightBox.visible = false;
            scene.add(highlightBox);

            createPlayer();
            setupControls();
            
            window.addEventListener('resize', onWindowResize, false);
        }

        function createPlayer() {
            player = new THREE.Group();
            
            const bodyGeo = new THREE.BoxGeometry(0.5, 0.7, 0.3);
            const bodyMat = new THREE.MeshStandardMaterial({ color: characterColor });
            playerBody = new THREE.Mesh(bodyGeo, bodyMat);
            playerBody.position.y = 0.85;
            playerBody.castShadow = true;
            player.add(playerBody);

            const headGeo = new THREE.BoxGeometry(0.35, 0.35, 0.35);
            const headMat = new THREE.MeshStandardMaterial({ color: 0xffdbac });
            headMesh = new THREE.Mesh(headGeo, headMat);
            headMesh.position.y = 1.4;
            headMesh.castShadow = true;
            player.add(headMesh);

            const legGeo = new THREE.BoxGeometry(0.2, 0.6, 0.2);
            const legMat = new THREE.MeshStandardMaterial({ color: 0x1e293b });
            
            leftLeg = new THREE.Mesh(legGeo, legMat);
            leftLeg.position.set(-0.12, 0.3, 0);
            leftLeg.castShadow = true;
            player.add(leftLeg);

            rightLeg = new THREE.Mesh(legGeo, legMat);
            rightLeg.position.set(0.12, 0.3, 0);
            rightLeg.castShadow = true;
            player.add(rightLeg);

            player.position.set(0, 0, 0);
            scene.add(player);
        }

        function buildTerrain(type) {
            blocks.forEach(b => scene.remove(b));
            blocks = [];

            const size = 50;
            let groundColor = 0x1e4620;
            if (type === 'akdeniz') groundColor = 0xc2a649;
            else if (type === 'ege') groundColor = 0x8b9a46;
            else if (type === 'ic_anadolu') groundColor = 0xd2b48c;
            else if (type === 'marmara') groundColor = 0x4a7c59;
            
            const planeGeo = new THREE.BoxGeometry(size, 1, size);
            const planeMat = new THREE.MeshStandardMaterial({ color: groundColor, roughness: 0.9 });
            const ground = new THREE.Mesh(planeGeo, planeMat);
            ground.position.y = -0.5;
            ground.receiveShadow = true;
            scene.add(ground);
            blocks.push(ground);

            for (let x = -20; x <= 20; x += 5) {
                for (let z = -20; z <= 20; z += 5) {
                    if (Math.random() > 0.4) {
                        createEnvironmentObject(type, x, 0, z);
                    }
                }
            }
        }

        function createEnvironmentObject(type, x, y, z) {
            if (type === 'karadeniz') {
                const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.3, 3), new THREE.MeshStandardMaterial({ color: 0x3d2314 }));
                trunk.position.set(x, y + 1.5, z);
                trunk.castShadow = true;
                scene.add(trunk);

                const leaves = new THREE.Mesh(new THREE.ConeGeometry(1.6, 3.5, 6), new THREE.MeshStandardMaterial({ color: 0x0f5214 }));
                leaves.position.set(x, y + 3.5, z);
                leaves.castShadow = true;
                scene.add(leaves);
            } else if (type === 'akdeniz' || type === 'ege') {
                const bush = new THREE.Mesh(new THREE.DodecahedronGeometry(0.8), new THREE.MeshStandardMaterial({ color: 0x556b2f }));
                bush.position.set(x, y + 0.6, z);
                bush.castShadow = true;
                scene.add(bush);
            } else if (type === 'ic_anadolu') {
                const rock = new THREE.Mesh(new THREE.DodecahedronGeometry(0.5), new THREE.MeshStandardMaterial({ color: 0x8b8b83 }));
                rock.position.set(x, y + 0.3, z);
                rock.castShadow = true;
                scene.add(rock);
            }
        }

        function setupControls() {
            document.addEventListener('keydown', (e) => {
                switch (e.code) {
                    case 'KeyW': moveForward = true; break;
                    case 'KeyS': moveBackward = true; break;
                    case 'KeyA': moveLeft = true; break;
                    case 'KeyD': moveRight = true; break;
                    case 'KeyV': toggleCamera(); break;
                    case 'KeyE': openQuiz(); break;
                }
            });

            document.addEventListener('keyup', (e) => {
                switch (e.code) {
                    case 'KeyW': moveForward = false; break;
                    case 'KeyS': moveBackward = false; break;
                    case 'KeyA': moveLeft = false; break;
                    case 'KeyD': moveRight = false; break;
                }
            });

            document.addEventListener('mousedown', (e) => {
                if (!isPointerLocked) {
                    document.body.requestPointerLock();
                    return;
                }
                if (e.button === 0) {
                    placeBlock();
                } else if (e.button === 2) {
                    removeBlock();
                }
            });

            document.addEventListener('mousemove', (e) => {
                if (document.pointerLockElement === document.body) {
                    cameraYaw -= e.movementX * 0.0025;
                    cameraPitch -= e.movementY * 0.0025;
                    cameraPitch = Math.max(-Math.PI / 3, Math.min(Math.PI / 3, cameraPitch));
                }
            });

            document.addEventListener('pointerlockchange', () => {
                isPointerLocked = document.pointerLockElement === document.body;
            });

            document.addEventListener('contextmenu', e => e.preventDefault());
        }

        function toggleCamera() {
            isThirdPerson = !isThirdPerson;
            document.getElementById('cam-mode').innerText = isThirdPerson ? 'TPS (V ile degis)' : 'FPS (V ile degis)';
        }

        function updateTargeting() {
            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
            const intersects = raycaster.intersectObjects(blocks);

            if (intersects.length > 0 && intersects[0].distance < 10) {
                const intersect = intersects[0];
                const normal = intersect.face.normal;

                let targetPos = new THREE.Vector3();
                if (intersect.object === blocks[0]) {
                    targetPos.copy(intersect.point).add(normal.clone().multiplyScalar(0.5)).floor().addScalar(0.5);
                } else {
                    targetPos.copy(intersect.object.position).add(normal);
                }

                highlightBox.position.copy(targetPos);
                highlightBox.visible = true;
            } else {
                highlightBox.visible = false;
            }
        }

        function placeBlock() {
            if (blockInventory <= 0) {
                alert("Yeterli blok yok! Soru cozerek blok kazanabilirsiniz (E tusu).");
                return;
            }

            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
            const intersects = raycaster.intersectObjects(blocks);

            if (intersects.length > 0 && intersects[0].distance < 10) {
                const intersect = intersects[0];
                const normal = intersect.face.normal;

                const blockGeo = new THREE.BoxGeometry(1, 1, 1);
                let blockColor = 0x7c4700; // Ahsap (Karadeniz)
                if (activeBiome === 'akdeniz') blockColor = 0x94a3b8; // Tas
                else if (activeBiome === 'ege') blockColor = 0xf8fafc; // Beyaz Tas
                else if (activeBiome === 'ic_anadolu') blockColor = 0xd97706; // Kerpic
                else if (activeBiome === 'marmara') blockColor = 0xb91c1c; // Tugla

                const blockMat = new THREE.MeshStandardMaterial({ color: blockColor, roughness: 0.6 });
                const newBlock = new THREE.Mesh(blockGeo, blockMat);

                if (intersect.object === blocks[0]) {
                    const targetPos = intersect.point.clone().add(normal.clone().multiplyScalar(0.5)).floor().addScalar(0.5);
                    newBlock.position.copy(targetPos);
                } else {
                    newBlock.position.copy(intersect.object.position).add(normal);
                }

                newBlock.castShadow = true;
                newBlock.receiveShadow = true;
                scene.add(newBlock);
                blocks.push(newBlock);

                blockInventory--;
                document.getElementById('block-count').innerText = blockInventory;
            }
        }

        function removeBlock() {
            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
            const intersects = raycaster.intersectObjects(blocks);

            if (intersects.length > 0 && intersects[0].distance < 10) {
                const obj = intersects[0].object;
                if (obj !== blocks[0]) {
                    scene.remove(obj);
                    blocks = blocks.filter(b => b !== obj);
                    blockInventory++;
                    document.getElementById('block-count').innerText = blockInventory;
                }
            }
        }

        function openQuiz() {
            if (document.pointerLockElement) document.exitPointerLock();
            
            const modal = document.getElementById('quiz-modal');
            const qList = questions[activeBiome] || questions['karadeniz'];
            const randomQ = qList[Math.floor(Math.random() * qList.length)];

            document.getElementById('quiz-question').innerText = randomQ.q;
            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';

            randomQ.a.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'opt-btn';
                btn.innerText = (idx + 1) + ") " + opt;
                btn.onclick = () => {
                    if (idx === randomQ.c) {
                        alert("Tebrikler! Dogru cevap. +5 Blok kazandiniz.");
                        blockInventory += 5;
                        document.getElementById('block-count').innerText = blockInventory;
                    } else {
                        alert("Yanlis cevap, tekrar deneyin.");
                    }
                    modal.style.display = 'none';
                };
                optionsContainer.appendChild(btn);
            });

            modal.style.display = 'block';
        }

        function startGame(biome) {
            activeBiome = biome;
            const colorInput = document.getElementById('char-color').value;
            characterColor = parseInt(colorInput.replace('#', '0x'));
            
            playerBody.material.color.setHex(characterColor);
            
            document.getElementById('current-biome').innerText = biome.toUpperCase();
            document.getElementById('menu-overlay').style.display = 'none';

            buildTerrain(biome);
            animate();
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);

            const time = performance.now();
            const delta = (time - prevTime) / 1000;
            prevTime = time;

            velocity.x -= velocity.x * 8.0 * delta;
            velocity.z -= velocity.z * 8.0 * delta;

            direction.z = Number(moveForward) - Number(moveBackward);
            direction.x = Number(moveRight) - Number(moveLeft);
            direction.normalize();

            const speed = 4.0;
            if (moveForward || moveBackward) velocity.z -= direction.z * speed * 8.0 * delta;
            if (moveLeft || moveRight) velocity.x -= direction.x * speed * 8.0 * delta;

            player.rotation.y = cameraYaw;

            player.translateX(-velocity.x * delta);
            player.translateZ(-velocity.z * delta);

            if (moveForward || moveBackward || moveLeft || moveRight) {
                leftLeg.rotation.x = Math.sin(time * 0.012) * 0.6;
                rightLeg.rotation.x = -Math.sin(time * 0.012) * 0.6;
            } else {
                leftLeg.rotation.x = 0;
                rightLeg.rotation.x = 0;
            }

            if (isThirdPerson) {
                const camOffset = new THREE.Vector3(0, 1.8, 3.5);
                camOffset.applyAxisAngle(new THREE.Vector3(0, 1, 0), cameraYaw);
                camera.position.copy(player.position).add(camOffset);
                camera.lookAt(player.position.clone().add(new THREE.Vector3(0, 1.2, 0)));
            } else {
                camera.position.copy(player.position).add(new THREE.Vector3(0, 1.4, 0));
                camera.rotation.set(cameraPitch, cameraYaw, 0, 'YXZ');
            }

            updateTargeting();
            renderer.render(scene, camera);
        }

        window.onload = init;
    </script>
</body>
</html>
